{"$schema": "https://schema.zeabur.app/template.json", "name": "sulfur-agent-web", "description": "硫磺督价与采购智能决策系统 - Zeabur 部署配置", "icon": "https://raw.githubusercontent.com/weikangceng7-ai/TrustWise-Pricing/main/public/logo.svg", "services": [{"type": "PREBUILT", "name": "web", "source": {"type": "github", "url": "https://github.com/weikangceng7-ai/TrustWise-Pricing.git", "branch": "master"}, "build": {"type": "NEXTJS"}, "env": {"BETTER_AUTH_URL": {"required": true, "value": "${ZEABUR_WEB_URL}", "description": "认证服务 URL，部署后自动替换为域名"}, "NEXT_PUBLIC_APP_URL": {"required": true, "value": "${ZEABUR_WEB_URL}", "description": "应用公开 URL"}, "DATABASE_URL": {"required": true, "description": "PostgreSQL 数据库连接字符串（连接 PostgreSQL 服务后自动填充）"}, "OPENAI_API_KEY": {"required": false, "description": "OpenAI API 密钥"}, "OPENROUTER_API_KEY": {"required": false, "description": "OpenRouter API 密钥（可替代 OpenAI）"}, "OPENAI_BASE_URL": {"required": false, "description": "AI API 基础 URL（如使用兼容 API）"}, "CRON_SECRET": {"required": false, "generate": {"type": "random"}, "description": "定时任务授权密钥"}}}, {"type": "PREBUILT", "name": "postgres", "source": {"type": "PREBUILT", "template": "POSTGRESQL"}, "env": {"POSTGRES_DB": {"value": "sulfur_agent"}}}], "connections": [{"from": "postgres", "type": "DATABASE_URL", "to": "web"}]}