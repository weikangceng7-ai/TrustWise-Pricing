{
  "name": "sulfur-agent-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed:yihua": "tsx --tsconfig tsconfig.json scripts/seed-yihua-knowledge.ts",
    "db:seed:yihua-code": "tsx --tsconfig tsconfig.json scripts/seed-yihua-code.ts",
    "db:seed:multi-prices": "tsx --tsconfig tsconfig.json scripts/seed-multi-dimensional-prices.ts",
    "db:seed:multi-commodity": "tsx --tsconfig tsconfig.json scripts/seed-multi-commodity.ts",
    "db:export-training-data": "tsx --tsconfig tsconfig.json scripts/export-training-data.ts",
    "db:export-and-retrain": "tsx --tsconfig tsconfig.json scripts/export-training-data.ts --retrain",
    "db:backup": "tsx --tsconfig tsconfig.json scripts/backup-db.ts",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:scrape": "playwright test tests/scraping",
    "test:automation": "playwright test tests/automation",
    "test:screenshot": "playwright test tests/automation/screenshots.ts",
    "test:report": "playwright test tests/automation/report-export.ts",
    "test:report:html": "playwright show-report",
    "mcp:dev": "tsx mcp-server/index.ts",
    "mcp:build": "tsc --project mcp-server/tsconfig.json",
    "mcp:http": "MCP_TRANSPORT=http tsx mcp-server/index.ts",
    "mcp:both": "MCP_TRANSPORT=both tsx mcp-server/index.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.118",
    "@base-ui/react": "^1.3.0",
    "@mendable/firecrawl-js": "^4.37.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openrouter/ai-sdk-provider": "^2.3.3",
    "@openrouter/sdk": "^0.9.11",
    "@radix-ui/react-compose-refs": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "^10.69.0",
    "@stripe/stripe-js": "^9.13.0",
    "@tanstack/react-query": "^5.90.21",
    "ai": "^6.0.116",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.5.5",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "drizzle-orm": "^0.45.1",
    "file-saver": "^2.0.5",
    "hono": "^4.12.8",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.577.0",
    "nanoid": "^5.1.7",
    "neo4j-driver": "^6.0.1",
    "next": "16.1.6",
    "openai": "^6.32.0",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.4",
    "rxjs": "^7.8.2",
    "sharp": "^0.33.5",
    "sonner": "^2.0.7",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "twilio": "^5.13.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "shadcn": "^4.0.8",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
