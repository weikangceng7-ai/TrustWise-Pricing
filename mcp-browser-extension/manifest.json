{
  "manifest_version": 3,
  "name": "Sulfur Agent - 硫磺市场数据助手",
  "version": "0.2.0",
  "description": "在 DeepSeek、豆包等 AI 聊天中一键注入硫磺市场数据，辅助采购决策",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://doubao.com/chat/*",
        "https://*.doubao.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/chat/*",
        "http://localhost:*/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
