# MCP Server 环境变量配置
# 复制此文件为 .env 并填入你的值，支持所有终端（CMD / PowerShell / bash）

# 主后端 API 地址
API_BASE_URL=https://sulfur-agent-web.vercel.app

# API 密钥（在 https://sulfur-agent-web.vercel.app 登录后获取）
API_KEY=sk_your_api_key_here

# 行业代码
INDUSTRY_CODE=sulfur

# 传输模式：stdio（本地 Claude Desktop）或 http（远程客户端 / 本地测试）
MCP_TRANSPORT=stdio

# HTTP 模式监听端口（仅 MCP_TRANSPORT=http 时生效）
MCP_PORT=3100

# 演示模式（设为 true 可跳过 API_KEY 校验，返回示例数据）
# DEMO_MODE=true
