<view class="page data-v-30e9e40d"><view class="header data-v-30e9e40d"><view class="back-btn data-v-30e9e40d" bindtap="{{a}}">‹ 返回</view><text class="title data-v-30e9e40d">知识图谱</text><text class="desc data-v-30e9e40d">企业供应链知识图谱可视化</text></view><view class="enterprise-selector data-v-30e9e40d"><picker class="data-v-30e9e40d" mode="selector" range="{{c}}" range-key="name" bindchange="{{d}}"><view class="selector-btn data-v-30e9e40d"><text class="data-v-30e9e40d">{{b}}</text><text class="arrow data-v-30e9e40d">▼</text></view></picker></view><view wx:if="{{e}}" class="graph-container data-v-30e9e40d"><view class="graph-section data-v-30e9e40d"><text class="section-title data-v-30e9e40d">核心节点</text><view class="nodes-grid data-v-30e9e40d"><view wx:for="{{f}}" wx:for-item="node" wx:key="d" class="{{['node-card', 'data-v-30e9e40d', node.e]}}"><view class="node-icon data-v-30e9e40d">{{node.a}}</view><view class="node-info data-v-30e9e40d"><text class="node-name data-v-30e9e40d">{{node.b}}</text><text class="node-type data-v-30e9e40d">{{node.c}}</text></view></view></view></view><view class="graph-section data-v-30e9e40d"><text class="section-title data-v-30e9e40d">关系网络</text><view class="relations-list data-v-30e9e40d"><view wx:for="{{g}}" wx:for-item="rel" wx:key="d" class="relation-item data-v-30e9e40d"><view class="relation-source data-v-30e9e40d">{{rel.a}}</view><view class="relation-arrow data-v-30e9e40d">{{rel.b}}</view><view class="relation-target data-v-30e9e40d">{{rel.c}}</view></view></view></view><view class="graph-section data-v-30e9e40d"><text class="section-title data-v-30e9e40d">关键指标</text><view class="metrics-grid data-v-30e9e40d"><view wx:for="{{h}}" wx:for-item="m" wx:key="c" class="metric-item data-v-30e9e40d"><text class="metric-value data-v-30e9e40d">{{m.a}}</text><text class="metric-label data-v-30e9e40d">{{m.b}}</text></view></view></view></view><view wx:if="{{i}}" class="loading data-v-30e9e40d"><text class="data-v-30e9e40d">加载知识图谱...</text></view>