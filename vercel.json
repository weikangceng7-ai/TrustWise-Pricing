{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["hkg1"],
  "crons": [
    {
      "path": "/api/cron/global-news",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/tracker/cron/hourly",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/tracker/cron/daily",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/tracker/cron/weekly",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/ingest-commodity-data",
      "schedule": "0 */4 * * 1-5"
    }
  ]
}
